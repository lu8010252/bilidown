# syntax=docker/dockerfile:1
# 只用来在有 Docker 的机器上交叉编译 Windows 版（不含 ffmpeg）：
#   docker build -f Dockerfile.windows --output dist-windows .
# 产物：dist-windows/bilidown.exe、static/、README.txt

FROM node:22-alpine AS web
ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /src/client
RUN corepack enable
COPY client/package.json client/pnpm-lock.yaml ./
RUN pnpm config set registry ${NPM_REGISTRY} && pnpm install --frozen-lockfile
COPY client/ ./
RUN pnpm build

FROM golang:1.23-alpine AS server
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY} CGO_ENABLED=0 GOOS=windows GOARCH=amd64
WORKDIR /src/server
COPY server/ ./
RUN go mod tidy && go build -trimpath -ldflags="-s -w" -o /out/bilidown.exe .

FROM scratch AS out
COPY --from=server /out/bilidown.exe /bilidown.exe
COPY --from=web /src/server/static /static
COPY windows/README.txt /README.txt
